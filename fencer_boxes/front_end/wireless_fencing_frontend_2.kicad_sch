	(text "8 pin header assignments\n\n1 : NC\n2 : ground\n3 : 3.3V\n4 : tip sense line\n5 : NC\n6 : tip pullup line\n7 : lame drive\n8 : lame sense"
		(exclude_from_sim no)
		(at 62.484 94.488 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "79895161-97ac-42f4-94ab-b2023cc69a88")
	)
	(text "R6 must be much larger than the protection resistor,\nso that when the tip switch is closed, 'we're at ground."
		(exclude_from_sim no)
		(at 217.932 64.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a70342d9-b774-47f1-a11a-976989e9ee18")
	)
	(text "pull up line"
		(exclude_from_sim no)
		(at 179.07 72.644 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "afe390a1-bfdd-4197-9167-a44bf6ddf28c")
	)
	(text "I want the lame detecetion to not have a DC connection to the weapon point\nwhen we're touching.\nSo i'll connect the point in front of the decoupling capacitor\nto two digital lines, through resistors. One is used to pull it up,\nthe other (20k) to sense; if low, we're not touching, if high, we are\n(circuit was opened), and we can check for presence of\nAC signal (setting the pull up line to high impedance)"
		(exclude_from_sim no)
		(at 105.156 65.024 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c48d3697-e720-4c0e-8c63-78c9f66d4027")
	)
	(text "1 / A: lame\n2 / B : weapon\n3 / C : ground / common"
		(exclude_from_sim no)
		(at 220.98 79.502 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "eb806329-15b5-4027-b78d-a6a8e0d718ba")
	)
